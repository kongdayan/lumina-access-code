# 复制为 .dev.vars 后填写（wrangler pages dev 本地联调自动读取）。
# 此文件可安全提交（仅占位值）。
# 线上请用 secret 配置：npx wrangler pages secret put ACCESS_TOKEN / CRED_BODY

# 访问令牌（页面门禁）
ACCESS_TOKEN=

# 机主本人凭证请求体 JSON（真实值只放本地 .dev.vars 与线上 secret）
CRED_BODY='{"tenantId":"10000","orgId":"1381","orgCode":"sh06","orgName":"星扬西岸中心","userId":"mock-user-id","userName":"mock-user","userMobile":"18800000000","appId":"wx992c0d7ad02e24b5","openId":"mock-open-id"}'
